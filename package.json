{
  "name": "fgsbm-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build:stage": "pnpm run lint && pnpm run format && tsc && vite build --mode development",
    "build:prod": "pnpm run lint && pnpm run format && tsc && vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint --ext .ts,.js,.vue src",
    "format": "prettier --write .",
    "cspell:check": "cspell --no-progress --show-suggestions --show-context --cache --gitignore",
    "cspell:check:all": "cspell --no-progress --show-suggestions --show-context .",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "html5-qrcode": "^2.3.8",
    "mapbox-gl": "^3.11.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.29",
    "vue-i18n": "^9.14.4",
    "vue-router": "4.0.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/compat": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.58.1",
    "@types/mapbox-gl": "^3.4.1",
    "@types/vue-router": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.21",
    "cspell": "^8.19.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.3.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "eslint-plugin-vue": "^10.0.0",
    "lint-staged": "^15.5.1",
    "lodash": "^4.17.21",
    "node-sass": "^8.0.0",
    "pinst": "^3.0.0",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sass": "1.77.8",
    "sass-loader": "^13.2.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^6.2.0",
    "vue-eslint-parser": "^10.1.3",
    "vue3-touch-events": "^4.1.6"
  },
  "engines": {
    "node": ">=20.15.1"
  },
  "lint-staged": {
    "**/*.{vue,js,ts,jsx,tsx}": [
      "cspell --no-progress --show-suggestions --show-context --no-must-find-files --cache --gitignore",
      "eslint --max-warnings=0"
    ],
    "!**/*.{vue,js,ts,jsx,tsx}": [],
    "**/*.{json,yml,yaml,css,scss,html}": [
      "prettier --check --ignore-unknown"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
